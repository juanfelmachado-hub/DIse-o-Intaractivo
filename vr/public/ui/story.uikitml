<!--
  Panel del cuento (VR). Muestra lo mismo que la interfaz web, en el mismo orden:
  capítulo, actividad, indicación o diálogo, y el texto del narrador con el botón
  Siguiente (que también pasa la página cuando la página está lista).
  Los textos los escribe StoryUISystem desde el estado del cuento original.
-->
<style>
  .root {
    flex-direction: column;
    width: 640;
  }
  .content {
    flex-direction: column;
    gap: 12;
    padding-top: 24;
    padding-bottom: 12;
    padding-left: 26;
    padding-right: 26;
  }
  .chapter {
    color: #8a5a00;
    font-size: 17;
    font-weight: 7000;
  }
  .chapter:dark {
    color: #ffd27a;
  }
  .mission {
    flex-direction: row;
    gap: 10;
    align-items: center;
    padding-top: 8;
    padding-bottom: 8;
    padding-left: 14;
    padding-right: 14;
    border-radius: 14;
    background-color: #f08a45;
  }
  .mission-text {
    color: #ffffff;
    font-size: 20;
    font-weight: 7000;
  }
  .talk {
    flex-direction: column;
    gap: 5;
    padding-top: 12;
    padding-bottom: 12;
    padding-left: 16;
    padding-right: 16;
    border-radius: 16;
    background-color: #2f5a3a;
  }
  .speaker {
    color: #c8f5b0;
    font-size: 16;
    font-weight: 7000;
  }
  .dialog {
    color: #ffffff;
    font-size: 23;
    line-height: 1.3;
  }
  .narration {
    color: #1c1d20;
    font-size: 25;
    line-height: 1.35;
  }
  .narration:dark {
    color: #fafaf7;
  }
  .actions {
    flex-direction: row;
    gap: 12;
    justify-content: flex-end;
    padding-left: 26;
    padding-right: 26;
    padding-bottom: 20;
  }
  .tools {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 10;
    justify-content: space-between;
    padding-left: 26;
    padding-right: 26;
    padding-bottom: 22;
  }
</style>
<Panel id="root" class="root">
  <div class="content">
    <div id="chapter" class="chapter">Nico y su guardián personal</div>
    <div id="mission-box" class="mission" style="display: none">
      <div id="mission-text" class="mission-text">Actividad</div>
    </div>
    <div id="talk-box" class="talk" style="display: none">
      <div id="speaker" class="speaker">Guardián</div>
      <div id="dialog" class="dialog">...</div>
    </div>
    <div id="narration" class="narration">...</div>
  </div>
  <div class="actions">
    <Button id="btn-turtle" style="display: none">
      <ButtonIcon>
        <Turtle></Turtle>
      </ButtonIcon>
      <ButtonLabel>Tortuga</ButtonLabel>
    </Button>
    <Button id="btn-steps" style="display: none">
      <ButtonIcon>
        <Check></Check>
      </ButtonIcon>
      <ButtonLabel id="btn-steps-label">Continuar</ButtonLabel>
    </Button>
    <Button id="btn-next">
      <ButtonIcon>
        <ChevronRight></ChevronRight>
      </ButtonIcon>
      <ButtonLabel id="btn-next-label">Siguiente</ButtonLabel>
    </Button>
  </div>
  <div class="tools">
    <Button id="btn-near" variant="secondary">
      <ButtonIcon>
        <Scaling></Scaling>
      </ButtonIcon>
      <ButtonLabel>Tamaño</ButtonLabel>
    </Button>
    <Button id="btn-recenter" variant="secondary">
      <ButtonIcon>
        <Move></Move>
      </ButtonIcon>
      <ButtonLabel>Mover</ButtonLabel>
    </Button>
    <Button id="btn-hide" variant="secondary">
      <ButtonIcon>
        <Minimize2></Minimize2>
      </ButtonIcon>
      <ButtonLabel>Ocultar</ButtonLabel>
    </Button>
    <Button id="btn-reset" variant="secondary">
      <ButtonIcon>
        <RotateCcw></RotateCcw>
      </ButtonIcon>
      <ButtonLabel>Reiniciar</ButtonLabel>
    </Button>
    <Button id="btn-menu" variant="secondary">
      <ButtonIcon>
        <Pause></Pause>
      </ButtonIcon>
      <ButtonLabel>Pausa</ButtonLabel>
    </Button>
  </div>
</Panel>
